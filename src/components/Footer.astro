    <div class="flex flex-col md:flex-row justify-between items-center">
      <div class="mb-4 md:mb-0">
        <p class="text-sm">
          © {year} V's DocHub. All rights reserved.
        </p>
      </div>
      <div class="flex space-x-6">
        <a href="/" class="text-sm text-gray-300 hover:text-white transition-colors">
          Home
        </a>
        <a href="/docs" class="text-sm text-gray-300 hover:text-white transition-colors">
          Documentation
        </a>
        <a href="/admin" class="text-sm text-gray-300 hover:text-white transition-colors">
          Admin
        </a>
      </div>
    </div>
  </div>
</footer> 